// BASE64 encoding and decoding
//
// Two words run through this module.
//
// A *piece* is the six bits that one BASE64 character stands for. `_u8_to_b64_table` reads a
// character into a piece, and `_b64_to_u8_table` writes a piece back as a character.
//
// A *group* is the unit the conversion works in: twenty-four bits, which are three bytes on one
// side and four pieces -- four characters -- on the other. A byte array whose length is not a
// multiple of three ends in a group of one or two bytes, which the padding character `=` fills out
// to four characters; a string may likewise end in a group of two or three pieces.
module Minilib.Encoding.Base64;

import Minilib.Text.Hex;
import Minilib.Text.StringEx;

// Encodes a byte array to a BASE64 string.
base64_encode: Array U8 -> String;
base64_encode = |src| (
    let src_size = src.@size;
    let dest = Array::fill((src_size + 2) / 3 * 4, 0_U8);
    let groups = src_size / 3;
    // Every three bytes are four characters, each standing for six bits of them.
    let dest = loop(
        (dest, 0, 0), |(dest, src_idx, dest_idx)|
        if src_idx + 3 > src_size { break $ dest };
        let b0 = src.@(src_idx);
        let b1 = src.@(src_idx + 1);
        let b2 = src.@(src_idx + 2);
        let dest = dest.set(dest_idx, _b64_to_u8_table.@(b0.shift_right(2_U8).i64))
                        .set(dest_idx + 1, _b64_to_u8_table.@(b0.shift_left(4_U8).bit_or(b1.shift_right(4_U8)).i64))
                        .set(dest_idx + 2, _b64_to_u8_table.@(b1.shift_left(2_U8).bit_or(b2.shift_right(6_U8)).i64))
                        .set(dest_idx + 3, _b64_to_u8_table.@(b2.i64));
        continue $ (dest, src_idx + 3, dest_idx + 4)
    );
    // A last group of one or two bytes, which the padding character fills out to four characters.
    let src_idx = groups * 3;
    let dest_idx = groups * 4;
    let rest = src_size - src_idx;
    let dest = if rest == 0 { dest }
    else if rest == 1 {
        let b0 = src.@(src_idx);
        dest.set(dest_idx, _b64_to_u8_table.@(b0.shift_right(2_U8).i64))
            .set(dest_idx + 1, _b64_to_u8_table.@(b0.shift_left(4_U8).i64))
            .set(dest_idx + 2, '=')
            .set(dest_idx + 3, '=')
    } else {
        let b0 = src.@(src_idx);
        let b1 = src.@(src_idx + 1);
        dest.set(dest_idx, _b64_to_u8_table.@(b0.shift_right(2_U8).i64))
            .set(dest_idx + 1, _b64_to_u8_table.@(b0.shift_left(4_U8).bit_or(b1.shift_right(4_U8)).i64))
            .set(dest_idx + 2, _b64_to_u8_table.@(b1.shift_left(2_U8).i64))
            .set(dest_idx + 3, '=')
    };
    dest.StringEx::from_array
);

// Decodes a string which contains BASE64 characters to a byte array.
// Characters other than BASE64 are ignored.
base64_decode: String -> Array U8;
base64_decode = |str| (
    let src = str.get_bytes;
    let src_size = str.@size;
    // Four six-bit pieces are three bytes, and a character standing for no piece only lowers the
    // count of pieces, so the string holds at most this many bytes however many of them it carries.
    let dest = Array::fill(src_size * 3 / 4, 0_U8);
    // `acc` holds the `filled` pieces read since the last three bytes were written.
    let (dest, dest_size, acc, filled) = loop(
        (dest, 0, 0, 0, 0), |(dest, src_idx, dest_size, acc, filled)|
        // A group of four characters that all stand for a piece is three whole bytes. The run of
        // such groups is walked on its own, so that the walk carries the two indices and nothing
        // else; it ends where a group is broken, which the reading below then takes one character
        // at a time.
        let (dest, src_idx, dest_size) = if filled == 0 {
            _whole_groups(src, src_size, dest, src_idx, dest_size)
        } else { (dest, src_idx, dest_size) };
        if src_idx == src_size { break $ (dest, dest_size, acc, filled) };
        let piece = _u8_to_b64_table.@(src.@(src_idx).i64);
        if piece == 0xFF_U8 { continue $ (dest, src_idx + 1, dest_size, acc, filled) };
        let acc = acc.shift_left(6).bit_or(piece.i64);
        if filled < 3 { continue $ (dest, src_idx + 1, dest_size, acc, filled + 1) };
        let dest = dest.set(dest_size, acc.shift_right(16).u8)
                        .set(dest_size + 1, acc.shift_right(8).bit_and(255).u8)
                        .set(dest_size + 2, acc.bit_and(255).u8);
        continue $ (dest, src_idx + 1, dest_size + 3, 0, 0)
    );
    // The two or three pieces a last, padded group leaves, which are one or two whole bytes.
    let (dest, dest_size) = if filled == 2 {
        (dest.set(dest_size, acc.shift_right(4).u8), dest_size + 1)
    } else if filled == 3 {
        (dest.set(dest_size, acc.shift_right(10).u8)
             .set(dest_size + 1, acc.shift_right(2).bit_and(255).u8), dest_size + 2)
    } else {
        (dest, dest_size)
    };
    dest.truncate(dest_size)
);

// Writes the bytes of every whole group of four characters that all stand for a piece, from
// `src_idx` onwards, and answers with where the walk stopped in the characters and in the bytes.
//
// # Parameters
// * `src` - The characters to read.
// * `src_size` - How many characters the string holds.
// * `dest` - The bytes written so far.
// * `src_idx` - The position to read from.
// * `dest_size` - How many bytes stand in `dest`.
_whole_groups: Array U8 -> I64 -> Array U8 -> I64 -> I64 -> (Array U8, I64, I64);
_whole_groups = |src, src_size, dest, src_idx, dest_size| (
    loop((dest, src_idx, dest_size), |(dest, src_idx, dest_size)|
        if src_idx + 4 > src_size { break $ (dest, src_idx, dest_size) };
        let p0 = _u8_to_b64_table.@(src.@(src_idx).i64);
        let p1 = _u8_to_b64_table.@(src.@(src_idx + 1).i64);
        let p2 = _u8_to_b64_table.@(src.@(src_idx + 2).i64);
        let p3 = _u8_to_b64_table.@(src.@(src_idx + 3).i64);
        // A piece is at most 63, and a character standing for none is 0xFF.
        if p0.bit_or(p1).bit_or(p2).bit_or(p3) >= 64_U8 { break $ (dest, src_idx, dest_size) };
        let dest = dest.set(dest_size, p0.shift_left(2_U8).bit_or(p1.shift_right(4_U8)))
                        .set(dest_size + 1, p1.shift_left(4_U8).bit_or(p2.shift_right(2_U8)))
                        .set(dest_size + 2, p2.shift_left(6_U8).bit_or(p3));
        continue $ (dest, src_idx + 4, dest_size + 3)
    )
);

// [0..63] -> [0..255]. A whole byte indexes the table, whose entries repeat every 64, so a six-bit
// piece read out of a byte needs no masking.
_b64_to_u8_table: Array U8;
_b64_to_u8_table = (
    Array::from_map(256, |j|
        let i = j.bit_and(63);
        if i < 26 { 'A' + i.u8 };
        if i < 52 { 'a' + (i - 26).u8 };
        if i < 62 { '0' + (i - 52).u8 };
        if i == 62 { '+' } else { '/' }
    )
);

// [0..255] -> [0..63], or 0xFF if not a BASE64 char
_u8_to_b64_table: Array U8;
_u8_to_b64_table = (
    Iterator::range(0, 64).fold(
        Array::fill(256, 0xFF_U8), |b64, arr|
        let val = _b64_to_u8_table.@(b64).i64;
        arr.set(val, b64.u8)
    )
);
